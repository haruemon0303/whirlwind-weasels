{
  "title": "夜想曲",
  "startSceneId": "opening",
  "scenes": {
    "opening": {
      "bg": "assets/images/bg_room.svg",
      "bgm": "bgm_main",
      "lines": [
        {
          "type": "narration",
          "text": "深夜零時を回った頃、私は一人、古い屋敷の一室にいた。"
        },
        {
          "type": "narration",
          "text": "窓の外は闇に包まれ、月明かりさえも届かない。",
          "effect": "shake"
        },
        {
          "type": "system",
          "text": "遠くから何かを叩く音が聞こえてくる……",
          "se": "knock"
        },
        {
          "type": "narration",
          "text": "その音は規則的で、まるで誰かが扉を叩いているようだった。"
        },
        {
          "type": "dialogue",
          "speaker": "アキラ",
          "text": "……誰だ？こんな時間に……"
        },
        {
          "type": "narration",
          "text": "私はゆっくりと立ち上がり、音のする方向を見つめた。"
        }
      ],
      "choices": [
        {
          "label": "扉の方へ向かう",
          "nextSceneId": "approach_door"
        },
        {
          "label": "窓の外を確認する",
          "nextSceneId": "check_window"
        },
        {
          "label": "部屋に留まる",
          "nextSceneId": "stay_room"
        }
      ]
    },
    "approach_door": {
      "bg": "assets/images/bg_hallway.svg",
      "bgm": "bgm_main",
      "lines": [
        {
          "type": "narration",
          "text": "私は意を決して扉へと向かった。",
          "se": "footstep"
        },
        {
          "type": "narration",
          "text": "廊下は暗く、足音だけが静寂を破っていた。"
        },
        {
          "type": "narration",
          "text": "扉の前に立つと、ノックの音が止んだ。",
          "effect": "flash"
        },
        {
          "type": "dialogue",
          "speaker": "アキラ",
          "text": "……誰もいない？"
        },
        {
          "type": "narration",
          "text": "そう思った瞬間、扉がゆっくりと開き始めた。",
          "se": "door_open"
        },
        {
          "type": "system",
          "text": "扉の向こうには……",
          "effect": "noise"
        }
      ],
      "choices": [
        {
          "label": "中を覗く",
          "nextSceneId": "peek_inside"
        },
        {
          "label": "逃げ出す",
          "nextSceneId": "escape"
        }
      ]
    },
    "check_window": {
      "bg": "assets/images/bg_room.svg",
      "bgm": "bgm_main",
      "lines": [
        {
          "type": "narration",
          "text": "私は窓に近づき、外を確認することにした。"
        },
        {
          "type": "narration",
          "text": "カーテンをそっと開けると、月明かりが差し込んできた。"
        },
        {
          "type": "dialogue",
          "speaker": "アキラ",
          "text": "何も……いない？"
        },
        {
          "type": "narration",
          "text": "しかし、視線を下に向けると、庭に何かの影が見えた。",
          "effect": "shake"
        },
        {
          "type": "system",
          "text": "それは人の形をしていたが、動かない。",
          "se": "ambient"
        },
        {
          "type": "narration",
          "text": "背筋が凍る思いがした。その時、背後から声が聞こえた。"
        },
        {
          "type": "dialogue",
          "speaker": "？？？",
          "text": "見つけたよ……"
        }
      ],
      "choices": [
        {
          "label": "振り返る",
          "nextSceneId": "bad_end_1"
        }
      ]
    },
    "stay_room": {
      "bg": "assets/images/bg_room.svg",
      "bgm": "bgm_main",
      "lines": [
        {
          "type": "narration",
          "text": "私は部屋に留まることにした。"
        },
        {
          "type": "dialogue",
          "speaker": "アキラ",
          "text": "きっと風か何かだろう……"
        },
        {
          "type": "narration",
          "text": "そう自分に言い聞かせ、再び椅子に座った。",
          "se": "lighter"
        },
        {
          "type": "narration",
          "text": "しかし、ノックの音は止まらなかった。",
          "effect": "noise"
        },
        {
          "type": "narration",
          "text": "むしろ、徐々に激しくなっていく。"
        },
        {
          "type": "system",
          "text": "ドンドンドン……！",
          "se": "knock",
          "effect": "shake"
        },
        {
          "type": "narration",
          "text": "私は耳を塞いだが、音は頭の中に響き続けた。"
        },
        {
          "type": "narration",
          "text": "そして、ついに扉が開いた。"
        }
      ],
      "choices": [
        {
          "label": "扉を見る",
          "nextSceneId": "bad_end_2"
        }
      ]
    },
    "peek_inside": {
      "bg": "assets/images/bg_hallway.svg",
      "bgm": "bgm_main",
      "lines": [
        {
          "type": "narration",
          "text": "私は恐る恐る、扉の向こうを覗いた。"
        },
        {
          "type": "narration",
          "text": "そこには、何もなかった。"
        },
        {
          "type": "dialogue",
          "speaker": "アキラ",
          "text": "誰もいない……？"
        },
        {
          "type": "narration",
          "text": "安堵のため息をついた瞬間、背後から声が聞こえた。"
        },
        {
          "type": "dialogue",
          "speaker": "？？？",
          "text": "探していたのは、こっちだよ。"
        },
        {
          "type": "narration",
          "text": "振り返ると、そこには見知らぬ人物が立っていた。",
          "effect": "flash"
        },
        {
          "type": "dialogue",
          "speaker": "リョウ",
          "text": "驚かせてしまったかな。私はリョウ。君を助けに来たんだ。"
        },
        {
          "type": "dialogue",
          "speaker": "アキラ",
          "text": "助ける……？一体、何が起きているんだ？"
        },
        {
          "type": "dialogue",
          "speaker": "リョウ",
          "text": "この屋敷には、古い呪いがかかっている。今夜中に脱出しなければ……"
        },
        {
          "type": "narration",
          "text": "リョウの言葉を信じるべきか、私は迷った。"
        }
      ],
      "choices": [
        {
          "label": "リョウと共に脱出する",
          "nextSceneId": "good_end"
        },
        {
          "label": "一人で考える時間が欲しい",
          "nextSceneId": "neutral_end"
        }
      ]
    },
    "escape": {
      "bg": "assets/images/bg_room.svg",
      "bgm": "bgm_main",
      "lines": [
        {
          "type": "narration",
          "text": "私は恐怖に駆られ、元の部屋へと逃げ戻った。",
          "se": "footstep"
        },
        {
          "type": "narration",
          "text": "扉を閉め、鍵をかけた。"
        },
        {
          "type": "dialogue",
          "speaker": "アキラ",
          "text": "はぁ……はぁ……"
        },
        {
          "type": "narration",
          "text": "しかし、安心したのも束の間、窓の外から視線を感じた。",
          "effect": "noise"
        },
        {
          "type": "narration",
          "text": "振り向くと、窓の向こうに無数の影が浮かんでいた。"
        }
      ],
      "choices": [
        {
          "label": "次へ",
          "nextSceneId": "bad_end_3"
        }
      ]
    },
    "good_end": {
      "bg": "assets/images/bg_ending.svg",
      "bgm": "bgm_ending",
      "lines": [
        {
          "type": "narration",
          "text": "私はリョウと共に屋敷を脱出することにした。"
        },
        {
          "type": "narration",
          "text": "二人で廊下を駆け抜け、玄関へと向かった。",
          "se": "footstep"
        },
        {
          "type": "dialogue",
          "speaker": "リョウ",
          "text": "もう少しだ、頑張れ！"
        },
        {
          "type": "narration",
          "text": "重い扉を押し開けると、外の空気が流れ込んできた。",
          "se": "door_open"
        },
        {
          "type": "narration",
          "text": "夜明け前の空は、まだ暗かったが、どこか安心感があった。"
        },
        {
          "type": "dialogue",
          "speaker": "アキラ",
          "text": "助かった……本当にありがとう。"
        },
        {
          "type": "dialogue",
          "speaker": "リョウ",
          "text": "無事で良かった。さあ、ここから離れよう。"
        },
        {
          "type": "narration",
          "text": "二人は屋敷から離れ、朝日が昇る方向へと歩いていった。"
        },
        {
          "type": "system",
          "text": "── GOOD END ──"
        }
      ],
      "choices": [
        {
          "label": "タイトルへ戻る",
          "nextSceneId": "opening"
        }
      ]
    },
    "neutral_end": {
      "bg": "assets/images/bg_room.svg",
      "bgm": "bgm_main",
      "lines": [
        {
          "type": "dialogue",
          "speaker": "アキラ",
          "text": "すまない、一人で考える時間が欲しい。"
        },
        {
          "type": "dialogue",
          "speaker": "リョウ",
          "text": "……そうか。わかった。でも、時間はあまりない。"
        },
        {
          "type": "narration",
          "text": "リョウは少し寂しそうな表情を浮かべ、廊下の奥へと消えていった。"
        },
        {
          "type": "narration",
          "text": "私は一人、部屋に残された。"
        },
        {
          "type": "narration",
          "text": "窓の外を見ると、空が徐々に白んできていた。"
        },
        {
          "type": "dialogue",
          "speaker": "アキラ",
          "text": "これで良かったのだろうか……"
        },
        {
          "type": "narration",
          "text": "答えは見つからないまま、夜が明けていった。"
        },
        {
          "type": "system",
          "text": "── NEUTRAL END ──"
        }
      ],
      "choices": [
        {
          "label": "タイトルへ戻る",
          "nextSceneId": "opening"
        }
      ]
    },
    "bad_end_1": {
      "bg": "assets/images/bg_room.svg",
      "bgm": "bgm_main",
      "lines": [
        {
          "type": "narration",
          "text": "私は恐る恐る振り返った。",
          "effect": "shake"
        },
        {
          "type": "narration",
          "text": "そこには、真っ黒な影が立っていた。"
        },
        {
          "type": "narration",
          "text": "声を上げる暇もなく、私の意識は闇に飲み込まれた。",
          "effect": "flash"
        },
        {
          "type": "system",
          "text": "── BAD END ──"
        }
      ],
      "choices": [
        {
          "label": "タイトルへ戻る",
          "nextSceneId": "opening"
        }
      ]
    },
    "bad_end_2": {
      "bg": "assets/images/bg_room.svg",
      "bgm": "bgm_main",
      "lines": [
        {
          "type": "narration",
          "text": "扉の向こうから、何かが這い出してきた。",
          "effect": "noise"
        },
        {
          "type": "narration",
          "text": "それは人の形をしているようで、していなかった。"
        },
        {
          "type": "narration",
          "text": "私は動くことができず、ただその場に立ち尽くしていた。",
          "effect": "shake"
        },
        {
          "type": "narration",
          "text": "そして……",
          "effect": "flash"
        },
        {
          "type": "system",
          "text": "── BAD END ──"
        }
      ],
      "choices": [
        {
          "label": "タイトルへ戻る",
          "nextSceneId": "opening"
        }
      ]
    },
    "bad_end_3": {
      "bg": "assets/images/bg_room.svg",
      "bgm": "bgm_main",
      "lines": [
        {
          "type": "narration",
          "text": "影たちは窓ガラスを突き破り、部屋の中へと入ってきた。",
          "effect": "shake",
          "se": "ambient"
        },
        {
          "type": "narration",
          "text": "私は逃げ場を失い、部屋の隅に追い詰められた。"
        },
        {
          "type": "narration",
          "text": "影たちがゆっくりと近づいてくる。",
          "effect": "noise"
        },
        {
          "type": "dialogue",
          "speaker": "アキラ",
          "text": "誰か……助けて……"
        },
        {
          "type": "narration",
          "text": "しかし、その声は誰にも届かなかった。",
          "effect": "flash"
        },
        {
          "type": "system",
          "text": "── BAD END ──"
        }
      ],
      "choices": [
        {
          "label": "タイトルへ戻る",
          "nextSceneId": "opening"
        }
      ]
    }
  }
}
